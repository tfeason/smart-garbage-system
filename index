  function geoToSvg(lat, lng) {
    const minLat = 22.770, maxLat = 22.825;
    const minLng = 120.345, maxLng = 120.415;
    const x = 40 + ((lng - minLng) / (maxLng - minLng)) * 520;
    const y = 390 - ((lat - minLat) / (maxLat - minLat)) * 350;
    return { x: Math.round(x * 10) / 10, y: Math.round(y * 10) / 10 };
  }

  function makeStop(name, lat, lng, isDynamic = false) {
    const pt = geoToSvg(lat, lng);
    return { name, lat, lng, x: pt.x, y: pt.y, isDynamic };

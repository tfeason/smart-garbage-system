<!DOCTYPE html>
<html lang="zh-Hant">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
  <title>智慧垃圾清理系統 - 第三組互動原型</title>
  <style>
    :root {
      --bg: #f1f5f9;
      --card: #ffffff;
      --primary: #0f766e;
      --primary-light: #ccfbf1;
      --primary-dark: #115e59;
      --accent: #f59e0b;
      --accent-light: #fef3c7;
      --danger: #dc2626;
      --danger-light: #fee2e2;
      --text: #0f172a;
      --muted: #64748b;
      --border: #e2e8f0;
      --shadow: 0 4px 14px rgba(15, 23, 42, 0.08);
    }
    * { box-sizing: border-box; -webkit-tap-highlight-color: transparent; }
    body {
      margin: 0;
      font-family: -apple-system, BlinkMacSystemFont, "PingFang TC", "Microsoft JhengHei", sans-serif;
      background: #cbd5e1;
      color: var(--text);
      display: flex;
      justify-content: center;
      min-height: 100vh;
    }
    .app-shell {
      width: 100%;
      max-width: 480px;
      background: var(--bg);
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      position: relative;
      box-shadow: 0 0 30px rgba(0,0,0,0.15);
      transition: max-width 0.25s ease;
    }
    .app-shell.tablet-wide { max-width: 900px; }

    .topbar {
      background: linear-gradient(135deg, var(--primary-dark), var(--primary));
      color: #fff;
      padding: 12px 16px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      position: sticky;
      top: 0;
      z-index: 30;
    }
    .topbar-title { font-size: 16px; font-weight: 700; display: flex; align-items: center; gap: 6px; }
    .topbar-sub { font-size: 11px; opacity: 0.85; }
    .topbar-actions { display: flex; gap: 6px; }
    .btn-top {
      background: rgba(255,255,255,0.18);
      border: 1px solid rgba(255,255,255,0.3);
      color: #fff;
      padding: 6px 10px;
      border-radius: 999px;
      font-size: 12px;
      font-weight: 600;
      cursor: pointer;
    }
    .btn-top.active { background: #f59e0b; border-color: #f59e0b; color: #1e293b; }

    .demo-drawer {
      display: none;
      background: #1e293b;
      color: #f8fafc;
      padding: 12px 16px;
      border-bottom: 2px solid #334155;
      font-size: 12px;
    }
    .demo-drawer.open { display: block; }
    .demo-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 8px;
      margin-top: 8px;
    }
    .btn-demo {
      background: #334155;
      color: #fff;
      border: 1px solid #475569;
      padding: 8px 10px;
      border-radius: 8px;
      font-size: 12px;
      font-weight: 600;
      cursor: pointer;
      text-align: left;
    }
    .btn-demo.on { background: #0f766e; border-color: #2dd4bf; }
    .btn-demo.warn { background: #991b1b; border-color: #f87171; }

    .content { flex: 1; padding: 14px; padding-bottom: 78px; overflow-y: auto; }
    .page { display: none; }
    .page.active { display: block; }

    .card {
      background: var(--card);
      border-radius: 16px;
      padding: 14px;
      margin-bottom: 12px;
      box-shadow: var(--shadow);
      border: 1px solid var(--border);
    }
    .card-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 8px;
    }

    /* 天氣與室外溫度看板 */
    .weather-strip {
      background: linear-gradient(135deg, #0284c7, #0369a1);
      color: #fff;
      border-radius: 14px;
      padding: 11px 14px;
      margin-bottom: 12px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      box-shadow: var(--shadow);
    }
    .weather-main { display: flex; align-items: center; gap: 10px; }
    .weather-temp { font-size: 24px; font-weight: 900; line-height: 1; }
    .weather-meta { font-size: 11px; opacity: 0.92; text-align: right; line-height: 1.45; }

    .badge {
      display: inline-flex;
      align-items: center;
      gap: 4px;
      padding: 3px 9px;
      border-radius: 999px;
      font-size: 11px;
      font-weight: 700;
    }
    .badge-ok { background: var(--primary-light); color: var(--primary-dark); }
    .badge-soon { background: #ffedd5; color: #c2410c; animation: pulse 1.2s infinite; }
    .badge-passed { background: #f1f5f9; color: #475569; border: 1px solid #cbd5e1; }
    .badge-danger { background: var(--danger-light); color: var(--danger); animation: pulse 1s infinite; }
    .badge-delay { background: var(--accent-light); color: #b45309; }
    .badge-dispatch { background: #dbeafe; color: #1d4ed8; }

    @keyframes pulse {
      0%, 100% { transform: scale(1); }
      50% { transform: scale(1.04); }
    }

    .loc-bar {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 8px;
      flex-wrap: wrap;
    }
    .btn-sm {
      background: var(--primary-light);
      color: var(--primary-dark);
      border: none;
      padding: 6px 10px;
      border-radius: 8px;
      font-size: 12px;
      font-weight: 700;
      cursor: pointer;
    }

    .bus-card {
      cursor: pointer;
      transition: transform 0.15s ease, border-color 0.15s ease;
    }
    .bus-card:active { transform: scale(0.99); }
    .bus-card.selected { border: 2px solid var(--primary); }
    .next-stop-box {
      background: #f8fafc;
      border-left: 4px solid var(--primary);
      padding: 9px 11px;
      border-radius: 8px;
      margin-top: 8px;
    }
    .next-stop-box.soon {
      background: #fff7ed;
      border-left-color: #ea580c;
    }
    .next-stop-title { font-size: 14px; font-weight: 800; color: var(--text); }
    .next-stop-meta { font-size: 12px; color: var(--muted); margin-top: 3px; display: flex; justify-content: space-between; flex-wrap: wrap; gap: 4px; }
    .passed-note {
      font-size: 11px;
      color: #64748b;
      margin-top: 6px;
      display: flex;
      align-items: center;
      gap: 4px;
    }

    .metrics-row {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 8px;
      margin-top: 10px;
    }
    .metric-box {
      background: #f8fafc;
      border: 1px solid var(--border);
      border-radius: 10px;
      padding: 8px;
      text-align: center;
    }
    .metric-val { font-size: 16px; font-weight: 800; color: var(--text); }
    .metric-lbl { font-size: 11px; color: var(--muted); margin-top: 2px; }

    .truck-visual {
      background: #f8fafc;
      border: 2px dashed #cbd5e1;
      border-radius: 14px;
      padding: 14px;
      text-align: center;
      margin: 10px 0;
    }
    .btn-primary {
      width: 100%;
      background: var(--primary);
      color: #fff;
      border: none;
      padding: 13px;
      border-radius: 12px;
      font-size: 15px;
      font-weight: 700;
      cursor: pointer;
      margin-top: 8px;
    }

    .bus-pills {
      display: flex;
      gap: 6px;
      overflow-x: auto;
      padding-bottom: 6px;
      margin-bottom: 8px;
    }
    .pill {
      flex-shrink: 0;
      padding: 7px 12px;
      border-radius: 999px;
      border: 1px solid var(--border);
      background: #fff;
      font-size: 12px;
      font-weight: 700;
      cursor: pointer;
    }
    .pill.active { background: var(--primary); color: #fff; border-color: var(--primary); }

    .map-wrap {
      position: relative;
      width: 100%;
      height: 340px;
      background: #e2e8f0;
      border-radius: 14px;
      overflow: hidden;
      border: 1px solid #cbd5e1;
      touch-action: none;
      user-select: none;
    }
    .map-controls {
      position: absolute;
      right: 10px;
      top: 10px;
      display: flex;
      flex-direction: column;
      gap: 6px;
      z-index: 10;
    }
    .map-ctrl-btn {
      width: 34px;
      height: 34px;
      border-radius: 8px;
      border: 1px solid #cbd5e1;
      background: rgba(255,255,255,0.95);
      font-size: 15px;
      font-weight: 800;
      cursor: pointer;
      box-shadow: 0 2px 6px rgba(0,0,0,0.12);
    }
    .map-mode-badge {
      position: absolute;
      left: 10px;
      top: 10px;
      z-index: 10;
      background: rgba(15, 23, 42, 0.82);
      color: #fff;
      padding: 5px 10px;
      border-radius: 999px;
      font-size: 11px;
      font-weight: 600;
    }
    .map-weather-pill {
      position: absolute;
      left: 10px;
      bottom: 10px;
      z-index: 10;
      background: rgba(255, 255, 255, 0.94);
      color: #0f172a;
      padding: 4px 10px;
      border-radius: 999px;
      font-size: 11px;
      font-weight: 700;
      box-shadow: 0 2px 6px rgba(0,0,0,0.12);
    }
    .ext-maps {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 8px;
      margin-top: 10px;
    }
    .btn-ext {
      padding: 10px;
      border-radius: 10px;
      border: 1px solid var(--border);
      background: #fff;
      font-size: 12px;
      font-weight: 700;
      cursor: pointer;
      text-align: center;
      text-decoration: none;
      color: var(--text);
      display: block;
    }

    .bottom-nav {
      position: fixed;
      bottom: 0;
      width: 100%;
      max-width: 480px;
      background: #fff;
      border-top: 1px solid var(--border);
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      padding: 8px 0;
      z-index: 30;
    }
    .app-shell.tablet-wide .bottom-nav { max-width: 900px; }
    .nav-item {
      border: none;
      background: none;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 3px;
      font-size: 11px;
      font-weight: 700;
      color: var(--muted);
      cursor: pointer;
    }
    .nav-item.active { color: var(--primary); }
    .nav-icon { font-size: 18px; }
  </style>
</head>
<body>
<div class="app-shell" id="appShell">
  <div class="topbar">
    <div>
      <div class="topbar-title">🚛 智慧垃圾清理系統</div>
      <div class="topbar-sub">第三組原型｜真實道路網・天氣溫控・自動增班</div>
    </div>
    <div class="topbar-actions">
      <button class="btn-top" id="btnLayout" onclick="toggleLayout()">平板寬版</button>
      <button class="btn-top" id="btnDemoToggle" onclick="toggleDemo()">模擬控制</button>
    </div>
  </div>

  <div class="demo-drawer" id="demoDrawer">
    <div style="font-weight:700; color:#5eead4;">🎛️ 簡報演示與模擬器控制（即時生效）</div>
    <div class="demo-grid">
      <button class="btn-demo on" id="btnRun" onclick="toggleRunning()">⏸️ 暫停／繼續行駛</button>
      <button class="btn-demo" id="btnSpeed" onclick="toggleSpeed()">⚡ 速度：1x（點此切換 4x）</button>
      <button class="btn-demo" id="btnWeather" onclick="cycleWeather()">🌦️ 切換天氣（晴朗／高溫／雷雨）</button>
      <button class="btn-demo" id="btnAddStop" onclick="addDynamicStopForSelected()">📍 自動新增臨時清運站點</button>
      <button class="btn-demo" id="btnLoadSurge" onclick="boostLoadToFull()">📦 載量滿載（自動增派新車）</button>
      <button class="btn-demo" id="btnFire" onclick="toggleFireAlert()">🔥 模擬高溫警報（65°C 悶燒）</button>
    </div>
  </div>

  <div class="content">
    <div class="page active" id="page-home">
      <div class="weather-strip" id="weatherBanner"></div>

      <div class="card">
        <div class="loc-bar">
          <div>
            <div style="font-size:11px; color:var(--muted); font-weight:700;">📍 目前偵測所在真實道路區域</div>
            <div style="font-size:15px; font-weight:800; margin-top:2px;" id="userLocName">燕巢區深水路一段（高科大燕巢校區）</div>
          </div>
          <div style="display:flex; gap:6px;">
            <button class="btn-sm" onclick="cycleUserLocation()">切換模擬路口</button>
            <button class="btn-sm" onclick="useRealGPS()">手機 GPS</button>
          </div>
        </div>
      </div>

      <div style="font-size:13px; font-weight:800; color:var(--muted); margin: 6px 2px 8px;" id="fleetSummary">
        執勤班次（沿真實道路網行駛）：
      </div>
      <div id="busListContainer"></div>
    </div>

    <div class="page" id="page-detail">
      <div id="detailContainer"></div>
    </div>

    <div class="page" id="page-map">
      <div class="bus-pills" id="mapBusPills"></div>

      <div class="map-wrap" id="mapWrap">
        <div class="map-mode-badge" id="mapModeLabel">單車真實道路路線（可拖曳／縮放）</div>
        <div class="map-weather-pill" id="mapWeatherPill">☀️ 室外 27°C・晴時多雲</div>
        <div class="map-controls">
          <button class="map-ctrl-btn" onclick="zoomMap(1.25)" title="放大">＋</button>
          <button class="map-ctrl-btn" onclick="zoomMap(0.8)" title="縮小">－</button>
          <button class="map-ctrl-btn" onclick="centerSelectedBus()" title="置中追蹤車輛">🎯</button>
          <button class="map-ctrl-btn" id="btnAllVehicles" onclick="toggleAllVehicles()" title="切換全區總覽">🌐</button>
        </div>
        <svg id="mapSvg" width="100%" height="100%" viewBox="0 0 600 420"></svg>
      </div>

      <div id="mapInfoCard" style="margin-top:10px;"></div>
    </div>
  </div>

  <div class="bottom-nav">
    <button class="nav-item active" id="nav-home" onclick="switchTab('home')">
      <span class="nav-icon">🏠</span>
      <span>主畫面</span>
    </button>
    <button class="nav-item" id="nav-detail" onclick="switchTab('detail')">
      <span class="nav-icon">🚛</span>
      <span>當前車輛資訊</span>
    </button>
    <button class="nav-item" id="nav-map" onclick="switchTab('map')">
      <span class="nav-icon">🗺️</span>
      <span>GPS 定位</span>
    </button>
  </div>
</div>


      geoToSvg(22.806, 120.396)
    ].map(p => `${p.x},${p.y}`).join(" ");
    html += `<polygon points="${waterPts}" fill="#bae6fd" stroke="#7dd3fc" stroke-width="2"/>`;
    const damLabel = geoToSvg(22.810, 120.399);
    html += `<text x="${damLabel.x}" y="${damLabel.y}" text-anchor="middle" font-size="9.5" fill="#0369a1" font-weight="800">阿公店水庫</text>`;

    const riverPts = [
      geoToSvg(22.805, 120.345),
      geoToSvg(22.795, 120.355),
      geoToSvg(22.788, 120.361),
      geoToSvg(22.780, 120.368)
    ].map(p => `${p.x},${p.y}`).join(" ");
    html += `<polyline points="${riverPts}" fill="none" stroke="#bae6fd" stroke-width="8" stroke-linecap="round"/>`;

    const nkust = geoToSvg(22.799, 120.376);
    html += `<rect x="${nkust.x - 36}" y="${nkust.y - 22}" width="72" height="44" rx="10" fill="#dcfce7" stroke="#86efac"/>`;
    html += `<text x="${nkust.x}" y="${nkust.y + 3}" text-anchor="middle" font-size="9" fill="#15803d" font-weight="800">高科大燕巢校區</text>`;

    const stu = geoToSvg(22.796, 120.354);
    html += `<rect x="${stu.x - 30}" y="${stu.y - 18}" width="60" height="36" rx="8" fill="#dcfce7" stroke="#86efac"/>`;
    html += `<text x="${stu.x}" y="${stu.y + 3}" text-anchor="middle" font-size="8.5" fill="#15803d" font-weight="800">樹德科大</text>`;

    ROUTES.forEach(r => {
      const roadPts = r.stops.map(s => `${s.x},${s.y}`).join(" ");
      html += `<polyline points="${roadPts}" fill="none" stroke="#ffffff" stroke-width="11" stroke-linecap="round" stroke-linejoin="round"/>`;
      html += `<polyline points="${roadPts}" fill="none" stroke="#cbd5e1" stroke-width="12" stroke-linecap="round" stroke-linejoin="round" opacity="0.35"/>`;
    });

    const lblHwy22 = geoToSvg(22.784, 120.369);
    html += `<text x="${lblHwy22.x}" y="${lblHwy22.y + 14}" font-size="8.5" fill="#64748b" font-weight="700">台22線・旗楠路</text>`;
    const lblShenshui = geoToSvg(22.802, 120.382);
    html += `<text x="${lblShenshui.x}" y="${lblShenshui.y - 12}" font-size="8.5" fill="#64748b" font-weight="700">高36・深水路</text>`;

    const busesToRender = state.showAllVehicles
      ? ROUTES
      : ROUTES.filter(b => b.id === state.selectedBusId);

    busesToRender.forEach(bus => {
      const t = getBusTelemetry(bus);
      const isMain = bus.id === state.selectedBusId;
      const splitIdx = Math.floor(Math.min(bus.progress, bus.stops.length - 1));

      let passedPts = [];
      for (let i = 0; i <= splitIdx; i++) {
        passedPts.push(`${bus.stops[i].x},${bus.stops[i].y}`);
      }
      passedPts.push(`${t.curX.toFixed(1)},${t.curY.toFixed(1)}`);
      html += `<polyline points="${passedPts.join(" ")}" fill="none" stroke="#94a3b8" stroke-width="${isMain ? 5 : 3}" stroke-linecap="round" stroke-linejoin="round"/>`;

      let remainPts = [`${t.curX.toFixed(1)},${t.curY.toFixed(1)}`];
      for (let i = splitIdx + 1; i < bus.stops.length; i++) {
        remainPts.push(`${bus.stops[i].x},${bus.stops[i].y}`);
      }
      html += `<polyline points="${remainPts.join(" ")}" fill="none" stroke="${bus.color}" stroke-width="${isMain ? 5 : 3}" stroke-dasharray="8 6" stroke-linecap="round" stroke-linejoin="round"/>`;

      if (!state.showAllVehicles || isMain) {
        bus.stops.forEach((st, idx) => {
          const isNext = idx === t.nextStopIdx && !t.isFinished;
          const isPassed = idx <= splitIdx;
          const r = isNext ? 6.5 : (st.isDynamic ? 5.8 : 4.2);
          const fill = isNext ? "#ea580c" : (st.isDynamic ? "#2563eb" : (isPassed ? "#94a3b8" : "#ffffff"));
          const stroke = (isNext || st.isDynamic) ? "#fff" : bus.color;
          html += `<circle cx="${st.x}" cy="${st.y}" r="${r}" fill="${fill}" stroke="${stroke}" stroke-width="2"/>`;
          if (idx === 0 || idx === bus.stops.length - 1 || isNext || idx === t.nearestIdx || st.isDynamic) {
            html += `<text x="${st.x}" y="${st.y - 9}" text-anchor="middle" font-size="9" font-weight="800" fill="${st.isDynamic ? "#1d4ed8" : "#1e293b"}">${st.name}</text>`;
          }
        });
      }

      const truckColor = (bus.load >= 100 || bus.fireAlert) ? "#dc2626" : bus.color;
      html += `
        <g style="cursor:pointer;" onclick="selectBusOnMap('${bus.id}')">
          <circle cx="${t.curX}" cy="${t.curY}" r="${isMain ? 15 : 11}" fill="${truckColor}" opacity="0.22"/>
          <circle cx="${t.curX}" cy="${t.curY}" r="${isMain ? 10 : 8}" fill="${truckColor}" stroke="#ffffff" stroke-width="2.5"/>
          <text x="${t.curX}" y="${t.curY + 3.5}" text-anchor="middle" font-size="10" fill="#fff">🚛</text>
          <rect x="${t.curX - 34}" y="${t.curY + 12}" width="68" height="15" rx="4" fill="#0f172a"/>
          <text x="${t.curX}" y="${t.curY + 22.5}" text-anchor="middle" font-size="8.5" font-weight="700" fill="#fff">${bus.id} (${bus.load}%)</text>
        </g>
      `;
    });

    html += `
      <circle cx="${state.userPos.x}" cy="${state.userPos.y}" r="11" fill="#2563eb" opacity="0.22"/>
      <circle cx="${state.userPos.x}" cy="${state.userPos.y}" r="6" fill="#2563eb" stroke="#ffffff" stroke-width="2"/>
      <text x="${state.userPos.x}" y="${state.userPos.y + 16}" text-anchor="middle" font-size="9.5" font-weight="800" fill="#1d4ed8">你的位置</text>
    `;

    html += `</g>`;
    svg.innerHTML = html;
  }

  function switchTab(tab) {
    state.tab = tab;
    document.querySelectorAll(".page").forEach(p => p.classList.remove("active"));
    document.querySelectorAll(".nav-item").forEach(n => n.classList.remove("active"));
    document.getElementById(`page-${tab}`).classList.add("active");
    document.getElementById(`nav-${tab}`).classList.add("active");
    renderAll();
  }

  function selectBusAndOpenDetail(id) {
    state.selectedBusId = id;
    switchTab("detail");
  }

  function goToMapForSelected() {
    state.showAllVehicles = false;
    switchTab("map");
    centerSelectedBus();
  }

  function selectBusOnMap(id) {
    state.selectedBusId = id;
    renderMapPage();
    centerSelectedBus();
  }

  function toggleAllVehicles() {
    state.showAllVehicles = !state.showAllVehicles;
    if (state.showAllVehicles) {
      state.zoom = 0.88;
      state.panX = 0;
      state.panY = 0;
    } else {
      centerSelectedBus();
    }
    renderMapPage();
  }

  function centerSelectedBus() {
    const bus = ROUTES.find(b => b.id === state.selectedBusId) || ROUTES[0];
    const t = getBusTelemetry(bus);
    state.zoom = 1.25;
    state.panX = (300 - t.curX) * state.zoom;
    state.panY = (210 - t.curY) * state.zoom;
    drawMapSvg();
  }

  function zoomMap(factor) {
    state.zoom = Math.max(0.6, Math.min(2.8, state.zoom * factor));
    drawMapSvg();
  }

  (function initMapDrag() {
    const wrap = document.getElementById("mapWrap");
    let dragging = false;
    let startX = 0, startY = 0;

    wrap.addEventListener("pointerdown", e => {
      if (e.target.closest("button")) return;
      dragging = true;
      startX = e.clientX - state.panX;
      startY = e.clientY - state.panY;
    });
    window.addEventListener("pointermove", e => {
      if (!dragging) return;
      state.panX = e.clientX - startX;
      state.panY = e.clientY - startY;
      drawMapSvg();
    });
    window.addEventListener("pointerup", () => { dragging = false; });
  })();

  function cycleUserLocation() {
    state.userLocIdx = (state.userLocIdx + 1) % USER_PRESETS.length;
    state.userPos = { ...USER_PRESETS[state.userLocIdx] };
    renderAll();
  }

  function useRealGPS() {
    if (!navigator.geolocation) {
      alert("此裝置瀏覽器不支援 GPS 定位，已維持目前模擬路口。");
      return;
    }
    navigator.geolocation.getCurrentPosition(
      pos => {
        const pt = geoToSvg(pos.coords.latitude, pos.coords.longitude);
        state.userPos = {
          name: `手機即時 GPS (${pos.coords.latitude.toFixed(4)}, ${pos.coords.longitude.toFixed(4)})`,
          lat: pos.coords.latitude,
          lng: pos.coords.longitude,
          x: Math.max(30, Math.min(570, pt.x)),
          y: Math.max(30, Math.min(390, pt.y))
        };
        renderAll();
      },
      () => {
        alert("未取得定位權限，已繼續使用燕巢真實路口模擬位置。");
      }
    );
  }

  function toggleLayout() {
    document.getElementById("appShell").classList.toggle("tablet-wide");
  }

  function toggleDemo() {
    const drawer = document.getElementById("demoDrawer");
    const btn = document.getElementById("btnDemoToggle");
    drawer.classList.toggle("open");
    btn.classList.toggle("active");
  }

  function toggleRunning() {
    state.running = !state.running;
    document.getElementById("btnRun").textContent = state.running ? "⏸️ 暫停／繼續行駛" : "▶️ 已暫停（點此繼續）";
  }

  function toggleSpeed() {
    state.speedMultiplier = state.speedMultiplier === 1 ? 4 : 1;
    document.getElementById("btnSpeed").textContent = `⚡ 速度：${state.speedMultiplier}x（點此切換）`;
  }

  function cycleWeather() {
    state.weatherIdx = (state.weatherIdx + 1) % WEATHER_PRESETS.length;
    renderAll();
  }

  function addDynamicStopForSelected() {
    const bus = ROUTES.find(b => b.id === state.selectedBusId) || ROUTES[0];
    if (!insertDynamicStop(bus)) {
      alert("此路線已達臨時增設站點上限（最多 4 站），確保路線運作流暢！");
    }
    renderAll();
  }

  function boostLoadToFull() {
    const bus = ROUTES.find(b => b.id === state.selectedBusId) || ROUTES[0];
    if (!bus.isFullReturning) {
      bus.load = 100;
      triggerDispatchForRoute(bus);
    }
    renderAll();
  }

  function toggleFireAlert() {
    const bus = ROUTES.find(b => b.id === state.selectedBusId) || ROUTES[0];
    bus.fireAlert = !bus.fireAlert;
    document.getElementById("btnFire").classList.toggle("warn", bus.fireAlert);
    renderAll();
  }

  function renderAll() {
    if (state.tab === "home") renderHome();
    if (state.tab === "detail") renderDetail();
    if (state.tab === "map") renderMapPage();
  }

  setInterval(() => {
    if (state.running) {
      state.tickCount += 1;

      if (state.tickCount % 18 === 0) {
        const activeBuses = ROUTES.filter(b => !b.isFullReturning && b.dynamicStopsAdded < 4);
        if (activeBuses.length > 0) {
          const target = activeBuses[Math.floor(Math.random() * activeBuses.length)];
          insertDynamicStop(target);
        }
      }

      for (let i = ROUTES.length - 1; i >= 0; i--) {
        const bus = ROUTES[i];

        if (bus.isFullReturning) {
          bus.returnCountdown -= 1;
          if (bus.returnCountdown <= 0) {
            if (state.selectedBusId === bus.id && ROUTES.length > 1) {
              state.selectedBusId = ROUTES[0].id === bus.id ? ROUTES[1].id : ROUTES[0].id;
            }
            ROUTES.splice(i, 1);
          }
          continue;
        }

        const maxIdx = bus.stops.length - 1;
        const weatherSpeedFactor = state.weatherIdx === 2 ? 0.85 : 1;
        bus.progress += bus.speedPerSec * state.speedMultiplier * weatherSpeedFactor;
        if (bus.progress >= maxIdx) {
          bus.progress = 0;
        }

        const randInc = Math.random() * 2.4 * state.speedMultiplier;
        bus.load = Math.min(100, Math.round((bus.load + randInc) * 10) / 10);

        if (bus.load >= 100 && ROUTES.length < 15) {
          triggerDispatchForRoute(bus);
          break;
        }
      }
    }
    renderAll();
  }, 1000);

  renderAll();
</script>
</body>
</html>

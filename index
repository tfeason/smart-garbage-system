  function getBusTelemetry(bus) {
    const maxIdx = bus.stops.length - 1;
    const clamped = Math.min(bus.progress, maxIdx);
    const segIdx = Math.min(Math.floor(clamped), maxIdx - 1);
    const frac = clamped - segIdx;

    const sA = bus.stops[segIdx];
    const sB = bus.stops[segIdx + 1];
    const curX = sA.x + (sB.x - sA.x) * frac;
    const curY = sA.y + (sB.y - sA.y) * frac;
    const curLat = sA.lat + (sB.lat - sA.lat) * frac;
    const curLng = sA.lng + (sB.lng - sA.lng) * frac;

    const isFinished = clamped >= maxIdx - 0.01;
    const nextStopIdx = isFinished ? maxIdx : segIdx + 1;
    const nextStop = bus.stops[nextStopIdx];
    const remainSegsToNext = Math.max(0, nextStopIdx - clamped);
    const rainDelay = state.weatherIdx === 2 ? 1 : 0;
    const remainSecToNext = Math.round(remainSegsToNext * 150 + (bus.delayMin + rainDelay) * 60);
    const remainMetersToNext = Math.round(remainSegsToNext * 680);
    const isArrivingSoon = !isFinished && !bus.isFullReturning && (remainSecToNext <= 60 || remainMetersToNext <= 150);

    const baseDate = new Date();
    baseDate.setHours(15, 0, 0, 0);
    const etaDate = new Date(baseDate.getTime() + remainSecToNext * 1000);
    const etaStr = etaDate.toTimeString().slice(0, 5);

    let nearestIdx = 0;
    let minDist = Infinity;
    bus.stops.forEach((st, idx) => {
      const d = Math.hypot(st.x - state.userPos.x, st.y - state.userPos.y);
      if (d < minDist) {
        minDist = d;
        nearestIdx = idx;
      }
    });
    const nearestStop = bus.stops[nearestIdx];
    const walkMeters = Math.round(minDist * 5.2);
    const hasPassedNearest = clamped > nearestIdx + 0.05;
    const passedAgoMin = hasPassedNearest ? Math.max(1, Math.round((clamped - nearestIdx) * 2.5)) : 0;

    return {
      curX, curY, curLat, curLng,
      isFinished, nextStopIdx, nextStop,
      remainSecToNext, remainMetersToNext, isArrivingSoon,
      etaStr, nearestIdx, nearestStop, walkMeters,
      hasPassedNearest, passedAgoMin
    };
  }

  function formatCountdown(sec) {
    if (sec <= 0) return "已到站";
    const m = Math.floor(sec / 60);
    const s = sec % 60;
    if (m === 0) return `${s} 秒`;
    return `${m} 分 ${s.toString().padStart(2, "0")} 秒`;
  }

  function insertDynamicStop(bus) {
    if (bus.dynamicStopsAdded >= 4) return false;
    const insertPos = Math.min(Math.floor(bus.progress) + 1, bus.stops.length - 1);
    const stA = bus.stops[Math.max(0, insertPos - 1)];
    const stB = bus.stops[insertPos];
    const num = bus.dynamicStopsAdded + 1;
    const midLat = (stA.lat + stB.lat) / 2;
    const midLng = (stA.lng + stB.lng) / 2;
    const newStop = makeStop(`🆕 臨時增設站 #${num}（路段滿溢通報）`, midLat, midLng, true);
    bus.stops.splice(insertPos, 0, newStop);
    bus.dynamicStopsAdded += 1;
    state.systemAlert = `📍 感測器通報滿溢！系統已沿路網為 ${bus.id} 自動插入「${newStop.name}」（目前共 ${bus.stops.length} 站）。`;
    return true;
  }

